; pull.mdp — Steered MD Pulling
; Template for interfacial PMF
; Rate: 0.001 nm/ps, Duration: 5 ns, k=10000

integrator     = md
dt             = 0.001
nsteps         = 5000000         ; 5 ns
nstxout-compressed = 1000
nstenergy      = 10000
nstlog         = 10000
constraints    = h-bonds
lincs_iter     = 2
lincs_order    = 6

cutoff-scheme  = Verlet
ns_type        = grid
nstlist        = 30
rcoulomb       = 1.0
rvdw           = 1.0
coulombtype    = PME
pme_order      = 4
fourierspacing = 0.1
DispCorr       = EnerPres

tcoupl         = V-rescale
tc-grps        = System
tau-t          = 0.1
ref-t          = 300

pcoupl         = no               ; NVT during pull

gen_vel        = yes
gen_temp       = 300
gen_seed       = -1

pbc            = xyz

freezedim      = Y Y N
freeze_grps    = SOLUTE

nstcomm        = 10
comm-mode      = Linear-acceleration-correction
comm-grps      = System

; ═══════════════════════════
; Pull parameters
; ═══════════════════════════
pull                 = yes
pull_ngroups         = 1
pull_ncoords         = 1
pull_group1_name     = SOLUTE
pull_coord1_type     = umbrella
pull_coord1_geometry = direction-periodic
pull_coord1_groups   = 0 1
pull_coord1_origin   = 0 0 10.0
pull_coord1_dim      = N N Y
pull_coord1_start    = yes
pull_coord1_rate     = 0.001        ; nm/ps
pull_coord1_k        = 10000        ; kJ/mol/nm^2
pull_coord1_vec      = 0 0 1

; For GROMACS 2020.6 with large pull groups:
; pull-group1-pbcatom = <center_atom_index>
; For GROMACS 2023.3 (GPU):
; pull-pbc-ref-prev-step-com = yes
